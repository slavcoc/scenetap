{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
   "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
   "include": ["src/**/*"],
  "exclude": ["node_modules"],
}